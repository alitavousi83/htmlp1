با استفاده از یکی از حلقه‌های for یا while مجموع اعداد 1 تا 200 که به 4 بخش‌پذیر هستن رو بدست بیار و مقدار نهایی رو در متغیری به نام result بریز و در نهایت مقدار این متغیر رو در خروجی نمایش بده.
let result = 0;
for (let i = 1; i <= 200; i++) {
  if (i % 4 === 0) {
    result += i;
  }
}
console.log(result);








تعدادی عدد داخل آرایه‌ای به نام 
numbers 
ذخیره شده.
 با پیمایش روی این آرایه، تعداد اعداد مثبت رو بدست بیار و در خروجی نمایش بده. 

یادت باشه حتما باید با استفاده از یکی از حلقه‌ها روی آرایه پیمایش انجام بدی.


const numbers = [
  5, 0, -3, 10,
  -2, -12, 3, 4,
  7, 6, -20, 1, 6, 
  23, -43, 1, 2  
];

let positiveCount = 0;

for (let i = 0; i < numbers.length; i++) {
  if (numbers[i] > 0) {
    positiveCount++;
  }
}

console.log("تعداد اعداد مثبت:", positiveCount);









