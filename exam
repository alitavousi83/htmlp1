دو تا ورودی از کاربر بگیر و نوعشون رو از رشته به عدد تغییر بده و در متغیر‌های num1 و num2 ذخیره کن. در ادامه حاصل ضرب این دوتا عدد رو حساب کن. اگر حاصل ضربشون منفی شد، رشته "negative"، اگر صفر شد رشته "zero" و در غیر این صورت رشته "positive" رو در متغیر result خیره کن.

let input1 = prompt("عدد اول را وارد کنید:");
let input2 = prompt("عدد دوم را وارد کنید:");

let num1 = Number(input1);
let num2 = Number(input2);

let product = num1 * num2;
let result;

if (product < 0) {
  result = "negative";
} else if (product === 0) {
  result = "zero";
} else {
  result = "positive";
}

